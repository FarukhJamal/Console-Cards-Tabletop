  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 0.7882353, g: 0.8156863, b: 0.8235294, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: 48b0c5504f075524787af6cf00c4d7d7, type: 3}
    m_FontSize: 19
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1.3
  m_Text: "<b>Esc</b>   this menu, or one step back (drop the selection, back to
    Select and move)\n<b>Drag</b>   move a piece          <b>Wheel</b>   turn a held
    piece, or zoom\n<b>Space + drag</b>   move the camera          <b>WASD / arrows</b>  
    move the camera\n<b>V</b>   select and move          <b>P</b>   ping         
    <b>M</b>   measure\n<b>Q / E</b>   turn          <b>F</b>   flip          <b>R</b>  
    roll a die (elsewhere: the rulebook)          <b>T</b>   deal\n<b>1\u20139</b>  
    over a deck: draw that many (elsewhere 1\u20134 change the view)\n<b>Ctrl + click</b>  
    select more          <b>G</b>   group cards into a deck          <b>Del</b>  
    remove\n<b>B</b>   the Toolbox          <b>H</b>   show or hide your hand         
    <b>L</b>   activity log\n<b>Enter</b>   end turn          <b>Ctrl Z / Ctrl Y</b>  
    undo / redo          <b>Right-click</b>   a piece's menu"
