%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8a12e43eec8a42b4aed60566566cea6d, type: 3}
  m_Name: TrapFloorDefaultRules
  m_EditorClassIdentifier: ConsoleCards.Definitions::ConsoleCards.Definitions.RuleSetDefinition
  stableId: trap-floor-rules-default
  displayName: Default
  gameStableId: 54460001-4f4f-4000-8000-000100000001
  basedOn: {fileID: 0}
  sections:
  - heading: 'Setup'
    numbered: 0
    entries:
    - stableId: tf-setup-traps
      text: 'The floor holds {value} Traps, picked at random from Spring, Crane, Fall, Slow, Sticky and Blind.'
      settingKind: 1
      settingKey: floor.count.trap-floor-floor-traps
      value: '18'
      displayValue: ''
      modeStableIds: []
    - stableId: tf-setup-friends
      text: '{value} Friends, picked at random from the Friend cards and Overcharged.'
      settingKind: 1
      settingKey: floor.count.trap-floor-floor-friends
      value: '4'
      displayValue: ''
      modeStableIds: []
    - stableId: tf-setup-abilities
      text: '{value} Abilities, picked at random. The same Ability can appear more than once.'
      settingKind: 1
      settingKey: floor.count.trap-floor-floor-abilities
      value: '6'
      displayValue: ''
      modeStableIds: []
    - stableId: tf-setup-fixed
      text: 'Also 6 Keys, the Grand Exit and the Secret Exit. All the counts must add up to the 36 tiles. Each later floor is one row and one column smaller, down to 3×3, with the same mix scaled down (both Exits and enough Keys always stay).'
      settingKind: 0
      settingKey: 
      value: ''
      displayValue: ''
      modeStableIds: []
    - stableId: tf-setup-placement
      text: 'Tiles are placed {value}.'
      settingKind: 3
      settingKey: floor.placement
      value: 'random'
      displayValue: 'at random'
      modeStableIds: []
    - stableId: tf-setup-avatar
      text: 'Each player starts with their Avatar''s ability.'
      settingKind: 0
      settingKey: 
      value: ''
      displayValue: ''
      modeStableIds: []
  - heading: 'Your turn'
    numbered: 1
    entries:
    - stableId: tf-turn-draw
      text: 'Draw from the Controller deck (one deck for everyone) until you hold {value}. Then draw 3 cards from the Ability deck beside the board yourself and buy any you can pay for (the Controller Cards you pay with go back into the Controller deck); put the ones you do not buy back on the Ability deck and shuffle it.'
      settingKind: 1
      settingKey: controller.hand-size
      value: '10'
      displayValue: ''
      hintTrigger: turn.start
      hintContext: player
      hintPriority: 4
      hintText: 
      hintHelper: 
      modeStableIds: []
    - stableId: tf-turn-move
      text: 'Move up to {value} tiles in one straight line: up, down, left or right. No diagonals and no turning. Or play an Action ability instead of moving.'
      settingKind: 1
      settingKey: move.tiles
      value: '2'
      displayValue: ''
      hintTrigger: drag.pawn
      hintContext: own
      hintPriority: 6
      hintText: 
      hintHelper: trapfloor.reach
      modeStableIds: []
    - stableId: tf-turn-move-athlete
      text: 'The Athlete moves up to {value} tiles instead.'
      settingKind: 1
      settingKey: move.tiles.avatar.54460014-4f4f-4000-8000-001400000006
      value: '3'
      displayValue: ''
      modeStableIds: []
    - stableId: tf-turn-flip
      text: 'Land on a face-down tile and it flips and takes effect. Searching is free.'
      settingKind: 0
      settingKey: 
      value: ''
      displayValue: ''
      hintTrigger: content.revealed
      hintContext: 
      hintPriority: 2
      hintText: 
      hintHelper: 
      modeStableIds: []
    - stableId: tf-turn-take
      text: 'Standing on a face-up Ability or Friend? You may take it: pay the Ability''s cost (a Friend is free). The tile card is yours: it stays under your pawn (you are safe there) and comes off the floor into your Hand (or beside your Console if your Hand is full) when you move off it next turn. Its space then stays empty. Skip it and the next player to land there may take it.'
      settingKind: 0
      settingKey: 
      value: ''
      displayValue: ''
      hintTrigger: content.revealed
      hintContext: Ability,Friend
      hintPriority: 6
      hintText: 
      hintHelper: trapfloor.prize
      modeStableIds: []
  - heading: 'Floor turn'
    numbered: 1
    entries:
    - stableId: tf-floor-roll
      text: 'After every player has had a turn, one player rolls the two dice (first die = column, second die = row) and that tile collapses: it is a hole from then on, and a player standing on it falls and is out for the rest of this floor. Any player lifts the tile off and sets it beside the board; if nobody does, End Floor Turn removes it. Whoever rolls changes each round.'
      settingKind: 0
      settingKey: 
      value: ''
      displayValue: ''
      hintTrigger: turn.start
      hintContext: floor
      hintPriority: 6
      hintText: 
      hintHelper: trapfloor.collapse
      modeStableIds:
      - trap-floor-mode-easy
      - trap-floor-mode-hard
    - stableId: tf-floor-impossible
      text: 'Once the first player escapes, turns go player, floor, player, floor: the players roll the floor dice after every player turn.'
      settingKind: 0
      settingKey: 
      value: ''
      displayValue: ''
      hintTrigger: 
      hintContext: 
      hintPriority: 4
      hintText: 
      hintHelper: trapfloor.collapse
      modeStableIds:
      - trap-floor-mode-impossible
  - heading: 'Abilities'
    numbered: 0
    entries:
    - stableId: tf-ability-action
      text: 'Action abilities are played on your turn instead of moving.'
      settingKind: 0
      settingKey: 
      value: ''
      displayValue: ''
      hintTrigger: turn.start
      hintContext: player
      hintPriority: 3
      hintText: 
      hintHelper: 
      modeStableIds: []
    - stableId: tf-ability-reaction
      text: 'Reaction abilities are played when a Trap hits you.'
      settingKind: 0
      settingKey: 
      value: ''
      displayValue: ''
      hintTrigger: content.revealed
      hintContext: Trap
      hintPriority: 6
      hintText: 
      hintHelper: trapfloor.traps-waiting
      modeStableIds: []
    - stableId: tf-ability-cost
      text: 'Each card shows its cost. Pay it in full to buy or take the card; using it later is free. Players never share a payment. The Controller Cards you pay with go back into the Controller deck; a used Ability goes on the Ability discard pile, which is shuffled into the Ability deck when that runs out.'
      settingKind: 0
      settingKey: 
      value: ''
      displayValue: ''
      modeStableIds: []
  - heading: 'Shop'
    numbered: 0
    entries:
    - stableId: tf-shop
      text: 'Shop: {value}. On your turn you may buy any Ability from the Shop (the SHOP icon at the top) by paying its cost. It goes to your Hand, or beside your Console when your Hand is full. An Ability without a price yet is not for sale. Turning the Shop on or off asks the table and applies at once.'
      settingKind: 2
      settingKey: shop.enabled
      value: 'off'
      displayValue: ''
      hintTrigger: turn.start
      hintContext: player
      hintPriority: 2
      hintText: 
      hintHelper: 
      modeStableIds: []
  - heading: 'Ability costs'
    numbered: 0
    entries:
    - stableId: tf-cost-check
      text: 'Check: {value}'
      settingKind: 4
      settingKey: card.cost.54460015-4f4f-4000-8000-001500000022
      value: 'Up + A/B/X/Y'
      displayValue: ''
      modeStableIds: []
    - stableId: tf-cost-dodge
      text: 'Dodge: {value}'
      settingKind: 4
      settingKey: card.cost.54460015-4f4f-4000-8000-00150000001f
      value: 'Down + A/B/X/Y'
      displayValue: ''
      modeStableIds: []
    - stableId: tf-cost-shield
      text: 'Shield: {value}'
      settingKind: 4
      settingKey: card.cost.54460015-4f4f-4000-8000-001500000020
      value: 'A + B + X + Y'
      displayValue: ''
      modeStableIds: []
    - stableId: tf-cost-rush
      text: 'Rush: {value}'
      settingKind: 4
      settingKey: card.cost.54460015-4f4f-4000-8000-001500000021
      value: 'Left/Right + A/B/X/Y'
      displayValue: ''
      modeStableIds: []
    - stableId: tf-cost-disarm
      text: 'Disarm: {value}'
      settingKind: 4
      settingKey: card.cost.54460015-4f4f-4000-8000-001500000023
      value: ''
      displayValue: 'not set yet'
      modeStableIds: []
    - stableId: tf-cost-push
      text: 'Push: {value}'
      settingKind: 4
      settingKey: card.cost.54460015-4f4f-4000-8000-00150000002a
      value: ''
      displayValue: 'not set yet'
      modeStableIds: []
    - stableId: tf-cost-notation
      text: 'A slash means any one of those cards, so Up + A/B/X/Y is an Up card and one of A, B, X or Y.'
      settingKind: 0
      settingKey: 
      value: ''
      displayValue: ''
      modeStableIds: []
  - heading: 'Traps'
    numbered: 0
    entries:
    - stableId: tf-trap-once
      text: 'A Trap only affects the player who flips it, once.'
      settingKind: 0
      settingKey: 
      value: ''
      displayValue: ''
      modeStableIds: []
    - stableId: tf-trap-chain
      text: 'If a Trap moves you onto a face-down tile, that tile flips too.'
      settingKind: 0
      settingKey: 
      value: ''
      displayValue: ''
      hintTrigger: content.revealed
      hintContext: Trap
      hintPriority: 3
      hintText: 
      hintHelper: 
      modeStableIds: []
    - stableId: tf-trap-spring
      text: 'Spring arrows follow the board as Player 1 sees it: up is toward the far side. Crane uses the two dice, first for the column, second for the row.'
      settingKind: 0
      settingKey: 
      value: ''
      displayValue: ''
      modeStableIds: []
    - stableId: tf-overcharged
      text: 'Overcharged gives the player who flips it +1 movement on their next turn. It is not a prize to take.'
      settingKind: 0
      settingKey: 
      value: ''
      displayValue: ''
      modeStableIds: []
    - stableId: tf-trap-out
      text: 'Knocked out? You are out for the rest of this floor and come back when it ends (won or lost). If every player is out, the floor is lost.'
      settingKind: 0
      settingKey: 
      value: ''
      displayValue: ''
      hintTrigger: game.activity
      hintContext: PlayerEliminated
      hintPriority: 6
      hintText: 
      hintHelper: 
      modeStableIds: []
  - heading: 'Goal'
    numbered: 0
    entries:
    - stableId: tf-goal-easy
      text: 'Bring {value} Key to the Grand Exit.'
      settingKind: 1
      settingKey: mode.keys-needed
      value: '1'
      displayValue: ''
      modeStableIds:
      - trap-floor-mode-easy
    - stableId: tf-goal-hard
      text: 'Bring all {value} Keys to the Grand Exit, by any means. Keys can be passed between players.'
      settingKind: 1
      settingKey: mode.keys-needed
      value: '3'
      displayValue: ''
      modeStableIds:
      - trap-floor-mode-hard
    - stableId: tf-goal-impossible
      text: '{value} Keys are needed to escape.'
      settingKind: 1
      settingKey: mode.keys-needed
      value: '3'
      displayValue: ''
      modeStableIds:
      - trap-floor-mode-impossible
    - stableId: tf-goal-win-mode
      text: 'Win mode: chosen in New table… (Regular, Team or Survival).'
      settingKind: 3
      settingKey: game.win-mode
      value: 'Team'
      displayValue: 'Team, one player must escape'
      modeStableIds: []
    - stableId: tf-goal-exit-roll
      text: 'Survival: once the Grand Exit is face up, stepping on a tile triggers it again, and prizes (Abilities, Friends) can no longer be taken.'
      settingKind: 0
      settingKey: 
      value: ''
      displayValue: ''
      hintTrigger: game.activity
      hintContext: ClaimedKey
      hintPriority: 4
      hintText: 
      hintHelper: 
      modeStableIds: []
    - stableId: tf-goal-secret-exit
      text: 'Exits are taken by landing on them. Regular: once the team has the Keys, the floor is won when every player still in stands on the Grand Exit, and a player holding a Key who lands on the Secret Exit wins the floor at once. Team: one player escaping wins. Survival: every player still in must escape (an escaped pawn leaves the floor) and the Grand Exit needs 3 Keys. A won or lost floor ends: everyone comes back and the next, smaller floor is dealt fresh (Avatars stay; Hands, Consoles and Abilities are dealt again). Win the last floor (3×3) to win the game.'
      settingKind: 0
      settingKey: 
      value: ''
      displayValue: ''
      modeStableIds: []
